{
  "name": "meterx",
  "version": "2027.0.2",
  "private": true,
  "description": "MeterX - Open source internet speed test browser extension",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run build --workspaces --if-present",
    "start": "node services/server/dist/server.js",
    "dev": "npm run build --workspaces --if-present && node services/server/dist/server.js",
    "test": "npm run test --workspaces --if-present && vitest run scripts && npm run check:docs",
    "package": "node scripts/package-stores.mjs",
    "dev:site": "node scripts/dev.mjs site",
    "dev:ext": "node scripts/dev.mjs ext",
    "check:docs": "bash scripts/guidelines.sh"
  },
  "keywords": [
    "speed-test",
    "browser-extension",
    "network-monitor"
  ],
  "author": "ajithakdev (https://github.com/ajithakdev)",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.5"
  }
}
